{
    "name": "specialpress/einvoice-validator-for-vampire",
    "description": "eInvoice Validator for VAMPIRE PHP - validates EN 16931 / XRechnung / Peppol / ZUGFeRD invoices in pure PHP, no Java. Uses the shared einvoice-report package for the report model and the Report Lite rendering, like its Java-based sibling.",
    "license": "GPL-2.0-or-later",
    "repositories": [
        {
            "type": "path",
            "url": "../libs/einvoice-report",
            "options": { "symlink": false }
        },
        {
            "type": "path",
            "url": "../libs/einvoice-reference-data",
            "options": { "symlink": false }
        },
        {
            "type": "path",
            "url": "../libs/einvoice-frontend-core",
            "options": { "symlink": false }
        }
    ],
    "require": {
        "php": ">=8.2",
        "ext-dom": "*",
        "ext-libxml": "*",
        "ext-bcmath": "*",
        "specialpress/einvoice-report": "^1.0",
        "specialpress/einvoice-reference-data": "^1.0",
        "specialpress/einvoice-frontend-core": "^1.1"
    },
    "config": {
        "optimize-autoloader": true
    }
}
